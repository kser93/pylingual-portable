* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.pyc binary
*.safetensors binary
*.gif binary

# Git submodule configuration stays LF on every platform
.gitmodules text eol=lf

# Third-party source snapshots; keep GitHub language statistics focused on src/
vendor/** linguist-vendored
