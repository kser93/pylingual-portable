# Portable runtime and downloaded artifacts (large, machine-specific)
/runtime/
/toolchains/
/downloads/
/workspace/

# Decompilation sessions and generated outputs are local-only
/workspace/sessions/
/workspace/exports/
/workspace/tmp/
/workspace/runs/

# Model packs are local; keep only small manifests in the repository
/models/
!/models/
/models/*
!/models/model-links.json
!/models/update-check.json

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Fixture .pyc files are build inputs and stay tracked
!/harness/fixtures/pyc/
!/harness/fixtures/pyc/**/*.pyc

# Generated decompiler output beside a fixture must never be committed
/harness/fixtures/pyc/**/*.py

# Logs and temporary files
*.log
*.tmp
